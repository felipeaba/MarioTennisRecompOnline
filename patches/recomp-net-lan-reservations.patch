+#ifdef RNET_MT_LAN_SEAT_LOCK
+/* A valid HELLO reserves a seat. Before START an expired reservation can be
+ * reclaimed. During a match the endpoint remains fixed. */
+static int hub_accept_source(RNetTransport *t, const rnet_u8 *buf, int n,
+                             const struct sockaddr_in *src)
+{
+    RNetDecodedPacket pkt;
+    if (rnet_proto_decode(buf, (size_t)n, t->hub_magic, &pkt) != 0 ||
+        pkt.session_id != t->hub_session_id ||
+        pkt.type == RNET_PKT_START || pkt.type == RNET_PKT_DELAY_SYNC)
+    {
+        return 0;
+    }
+
+    int slot = pkt.local_slot;
+    if (slot < 1 || slot >= t->hub_expected_slots)
+    {
+        return 0;
+    }
+    rnet_u64 now = rnet_os_monotonic_ms();
+    int reserved = t->hub_slot_known[slot] &&
+        (t->hub_locked || now - t->hub_last_rx_ms[slot] <= 3000ULL);
+    if (reserved && !sockaddr_equal(&t->hub_slot_addr[slot], src))
+    {
+        if (pkt.type == RNET_PKT_HELLO)
+        {
+            rnet_u8 reply[RNET_MAX_PACKET];
+            int len = rnet_proto_encode_modset_ack(reply, sizeof(reply), t->hub_magic,
+                t->hub_session_id, 0, 4, "seat already occupied");
+            if (len > 0)
+                (void)rnet_os_sendto(t->sock, reply, (size_t)len, src);
+        }
+        return 0;
+    }
+    if (!reserved && (t->hub_locked || pkt.type != RNET_PKT_HELLO ||
+                      pkt.slot_count != t->hub_expected_slots))
+    {
+        return 0;
+    }
+    t->hub_last_rx_ms[slot] = now;
+    return 1;
+}
+#endif
