<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mario Tennis 64 Online" Width="880" Height="665"
        MinWidth="780" MinHeight="665" WindowStartupLocation="CenterScreen"
        Background="#10201B" Foreground="#F4F8EE" FontFamily="Inter, Segoe UI" FontSize="14"
        AutomationProperties.AutomationId="LanLauncher">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#ADC2B6"/>
        <SolidColorBrush x:Key="Accent" Color="#CBEF78"/>
        <SolidColorBrush x:Key="Stroke" Color="#38544A"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A2E26"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="17"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="#15200D"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#264137"/>
            <Setter Property="BorderBrush" Value="#527568"/>
            <Setter Property="Foreground" Value="#F4F8EE"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F8EE"/>
            <Setter Property="Background" Value="#10221A"/>
            <Setter Property="BorderBrush" Value="#527568"/>
            <Setter Property="CaretBrush" Value="#CBEF78"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Outline" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="#CBEF78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Outline" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="27,21,27,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,17">
            <TextBlock FontSize="37" FontWeight="Bold">
                <Run Text="Mario Tennis 64 "/><Run Text="Online" Foreground="{StaticResource Accent}"/>
            </TextBlock>
            <TextBlock Margin="1,3,0,0" FontSize="15" Foreground="{StaticResource Muted}"
                       Text="Jogue com um amigo na mesma rede."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModePicker" Height="37" Padding="7,0" VerticalContentAlignment="Center"
                              AutomationProperties.AutomationId="ModePicker" AutomationProperties.Name="Modo da partida"/>
                    <ComboBox Grid.Column="2" x:Name="GuestSeat" Height="37" MinWidth="112"
                              Padding="6,0" VerticalContentAlignment="Center" Visibility="Collapsed"
                              AutomationProperties.AutomationId="GuestSeat" AutomationProperties.Name="Seu lugar como convidado"/>
                </Grid>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Hospedar" FontWeight="Bold" FontSize="23"/>
                        <TextBlock Text="Copie seu endereço e envie ao amigo antes de hospedar."
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,11"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="HostAddress" Height="37" VerticalContentAlignment="Center"
                                      Background="#F0F6E7" Foreground="#14261D" Padding="7,0"
                                      AutomationProperties.AutomationId="HostAddress"
                                      AutomationProperties.Name="Seu endereço IP"/>
                            <Button Grid.Column="2" x:Name="CopyButton" Content="Copiar"
                                    Style="{StaticResource Secondary}" MinHeight="37"
                                    AutomationProperties.AutomationId="CopyButton"/>
                        </Grid>
                        <Button x:Name="HostButton" Content="_Hospedar partida"
                                Style="{StaticResource Action}" Margin="0,10,0,0"
                                AutomationProperties.AutomationId="HostButton"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Entrar" FontWeight="Bold" FontSize="23"/>
                        <TextBlock Text="Cole o endereço que seu amigo enviou."
                                   Foreground="{StaticResource Muted}" Margin="0,5,0,11"/>
                        <Grid Height="38">
                            <TextBox x:Name="JoinAddress" Style="{StaticResource Field}" MaxLength="45"
                                     AutomationProperties.AutomationId="JoinAddress"
                                     AutomationProperties.Name="Endereço IP do amigo"
                                     AutomationProperties.HelpText="Por exemplo, 192.168.1.20"/>
                            <TextBlock x:Name="AddressHint" Text="Ex. 192.168.1.20" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
                        </Grid>
                        <Button x:Name="JoinButton" Content="_Entrar na partida"
                                Style="{StaticResource Secondary}" Margin="0,10,0,0"
                                AutomationProperties.AutomationId="JoinButton"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="13">
                <StackPanel>
                    <Border x:Name="CourtPanel" Height="170" CornerRadius="8">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="7,16,7,7">
                        <TextBlock Text="Na quadra" FontSize="21" FontWeight="Bold"/>
                        <TextBlock x:Name="ModeGuide" Margin="0,7,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}"/>
                        <Border Margin="0,15,0,11" Background="{StaticResource Stroke}" Height="1"/>
                        <TextBlock Text="Controles" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}">
                            No teclado, Enter inicia, L vai à direita no menu, Espaço confirma e WASD move.
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#172B23" BorderBrush="{StaticResource Stroke}"
                BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Signal" Width="8" Height="8" VerticalAlignment="Center"
                         Margin="1,0,9,0" Fill="{StaticResource Accent}"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="Pronto para jogar"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="StatusText"/>
                <Button Grid.Column="2" x:Name="LogButton" Content="Abrir log"
                        Style="{StaticResource Secondary}" MinHeight="32" Padding="10,3" Margin="6,0,0,0"
                        Visibility="Collapsed" AutomationProperties.AutomationId="LogButton"/>
                <Button Grid.Column="3" x:Name="CancelButton" Content="Cancelar"
                        Style="{StaticResource Secondary}" MinHeight="32" Padding="10,3" Margin="6,0,0,0"
                        Visibility="Collapsed" AutomationProperties.AutomationId="CancelButton"/>
            </Grid>
        </Border>
    </Grid>
</Window>



